{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "legacy-ledger-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/ledger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ledger" },
          { "PathPrefix": "/api/v1/ledger" }
        ]
      },
      "canonical-v1-ledger-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/v1/ledger/{**catch-all}"
        }
      },
      "legacy-accounts-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/accounts" },
          { "PathPrefix": "/api/v1/accounts" }
        ]
      },
      "canonical-v1-accounts-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "processing-cluster": {
        "Destinations": {
          "http-destination": {
            "Address": "http://localhost:5201"
          },
          "https-destination": {
            "Address": "https://localhost:7198"
          }
        }
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Grafana.Loki", "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\MyAppLogs\\integration-bus\\gateway-api\\log-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [ { "key": "service_name", "value": "integration-bus-gateway-api" } ]
        }
      }
    ]
  }
}
