{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://+:6005",
        "Protocols": "Http2"
      },
      "Http": {
        "Url": "http://+:6006",
        "Protocols": "Http1"
      }
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8180/realms/integration-bus",
    "Audience": "",
    "RequireHttpsMetadata": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Grafana.Loki", "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\MyAppLogs\\integration-bus\\identity-service\\log-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [ { "key": "service_name", "value": "integration-bus-identity-service" } ]
        }
      }
    ]
  }
}
