{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "legacy-ledger-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/ledger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ledger" },
          { "PathPrefix": "/api/v1/ledger" }
        ]
      },
      "canonical-v1-ledger-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/v1/ledger/{**catch-all}"
        }
      },
      "legacy-accounts-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/accounts" },
          { "PathPrefix": "/api/v1/accounts" }
        ]
      },
      "canonical-v1-accounts-route": {
        "ClusterId": "processing-cluster",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "processing-cluster": {
        "Destinations": {
          "http-destination": {
            "Address": "http://localhost:5201"
          },
          "https-destination": {
            "Address": "https://localhost:7198"
          }
        }
      }
    }
  }
}
